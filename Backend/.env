# ─── MQTT Broker ───────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=water-quality-backend

# ─── Firebase ──────────────────────────────────────────────────
# Path to your downloaded Firebase service account JSON key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://water-monitor-b87e5-default-rtdb.firebaseio.com/

# ─── Alert Email (Gmail SMTP) ──────────────────────────────────
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=alert-recipient@gmail.com
# Use a Gmail App Password (not your real password):
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD=your-gmail-app-password

# ─── Backend HTTP Server ───────────────────────────────────────
PORT=3001

# ─── Alert Thresholds ──────────────────────────────────────────
# These define contamination limits
PH_MIN=6.5
PH_MAX=8.5
TURBIDITY_MAX=4.0
DO_MIN=6.0
TDS_MAX=500
